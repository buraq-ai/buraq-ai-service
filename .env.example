# LLM Settings
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key-here
OLLAMA_MODEL=llama3.2

# Vector Database (local)
CHROMA_DB_PATH=./chroma_db

# BURAQ-23: ChromaDB Docker Connection
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=buraq_documents

# BURAQ-23: Spring Boot Callback
SPRING_BOOT_URL=http://localhost:8081
INTERNAL_SERVICE_KEY=your-secret-service-key-here

# JWT (for communication with Java backend)
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256

# App
DEBUG=true